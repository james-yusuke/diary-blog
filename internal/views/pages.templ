package views

import (
	"net/url"

	"github.com/james-yusuke/diary-blog/internal/content"
)

templ Layout(site content.SiteConfig, pageTitle string) {
	<!doctype html>
	<html lang="ja">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ site.Description }/>
			<title>{ pageTitle }</title>
			<link rel="icon" type="image/png" href="https://avatars.githubusercontent.com/u/238946603?v=4"/>
			<link rel="apple-touch-icon" href="https://avatars.githubusercontent.com/u/238946603?v=4"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet"/>
			<script>
				try {
					const savedTheme = localStorage.getItem("diary-theme")
					if (savedTheme === "light" || savedTheme === "system") document.documentElement.dataset.theme = savedTheme
				} catch {}
			</script>
			<link rel="stylesheet" href="/assets/site.css?v=20261112-research"/>
			<script defer src="/assets/site.js?v=20261112-research"></script>
			<script type="module" src="/assets/mermaid.js?v=20261112-research"></script>
		</head>
		<body>
			<a class="skip-link" href="#main">本文へ移動</a>
			<header class="site-header">
				<div class="shell nav-shell">
					<a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>{ site.Title }</a>
					<nav class="primary-nav" aria-label="主要ナビゲーション">
						<a href="/">Articles</a>
						<a href="/?q=CVE">Security</a>
						<a href="/about">About</a>
					</nav>
					<div class="nav-actions">
						<button class="search-trigger" type="button" data-command-trigger aria-haspopup="dialog" aria-controls="command-palette" aria-label="記事を検索">
							<span class="search-icon" aria-hidden="true"></span><span>検索</span><span class="search-trigger__key" aria-hidden="true">⌘K</span>
						</button>
						<button class="theme-toggle" type="button" data-theme-toggle aria-label="表示テーマを切り替える">
							<span class="theme-toggle__icon" data-theme-icon aria-hidden="true">☾</span><span class="theme-toggle__label" data-theme-label>ダーク</span>
						</button>
					</div>
				</div>
			</header>
			{ children... }
			<footer class="site-footer">
				<div class="shell footer-inner">
					<span>{ site.AuthorName } · engineering notes</span><div><a href={ templ.SafeURL(site.GitHubURL) }>GitHub</a><a href={ templ.SafeURL(site.RepositoryURL) }>Repository</a><a href="/feed.xml">RSS</a></div>
				</div>
			</footer>
			<dialog class="command-palette" id="command-palette" aria-label="記事を検索">
				<div class="command-head"><form action="/" method="get"><input class="command-input" id="command-query" name="q" type="search" aria-label="記事・CVE・タグを検索" placeholder="記事・CVE・タグを検索" autocomplete="off"/></form><button class="command-close" type="button" data-command-close aria-label="検索を閉じる">Esc</button></div>
				<div class="command-results" role="listbox" aria-label="検索候補"><p class="command-group">Navigate</p><a class="command-item" data-command-item aria-selected="true" role="option" href="/"><span>すべての記事</span><span class="command-hint">/</span></a><a class="command-item" data-command-item aria-selected="false" role="option" href="/?q=CVE"><span>CVE・セキュリティを検索</span><span class="command-hint">CVE</span></a><a class="command-item" data-command-item aria-selected="false" role="option" href="/about"><span>About</span><span class="command-hint">info</span></a><a class="command-item" data-command-item aria-selected="false" role="option" href="/feed.xml"><span>RSS feed</span><span class="command-hint">xml</span></a></div>
				<div class="command-foot"><span>↑ ↓ 移動</span><span>↵ 開く</span><span>Esc 閉じる</span></div>
			</dialog>
		</body>
	</html>
}

templ HomePage(site content.SiteConfig, posts []content.Post, tags []content.Tag, query string) {
	@Layout(site, "diary — "+site.AuthorName) {
		<main id="main">
			if query == "" {
				<section class="index-intro">
					<div class="shell">
						<h1>開発とセキュリティの<span>技術ノート</span></h1>
						<p>Go、Web開発、セキュリティを中心に、調べたことや手を動かして得た学びを記録しています。</p>
					</div>
				</section>
			} else {
				<header class="shell archive-header search-header">
					<a class="back-link" href="/">← 記事一覧</a>
					<h1>「{ query }」の検索結果</h1>
				</header>
			}
			<section class="shell index-layout" aria-label="記事一覧">
				<div class="index-meta">
					<span>記事 { len(posts) } 本</span>
					if query == "" && len(posts) > 0 {
						<span>最新記事 <time datetime={ posts[0].Published.Format("2006-01-02") }>{ posts[0].DisplayDate() }</time></span>
					}
				</div>
				if len(posts) == 0 {
					if query == "" {
						<p class="empty-state">公開済みの記事はありません。</p>
					} else {
						<p class="empty-state">条件に一致する記事はありません。別のキーワードを試してください。</p>
					}
				} else {
					@PostList(posts, false)
				}
				if len(tags) > 0 {
					@TopicPanel("トピック", tags)
				}
			</section>
		</main>
	}
}

templ PostList(posts []content.Post, related bool) {
	<div class="post-list">
		for _, post := range posts {
			<article class="post-card">
				<a class="post-card-link" href={ templ.SafeURL(post.URL()) } aria-labelledby={ "card-" + post.Slug }>
					<div class="post-cover" data-cover={ postCoverKind(post) } aria-hidden="true"><span class="cover-art"></span></div>
					<div class="post-card-body">
						<p class="post-meta"><span class="source-label" data-source={ post.Source }>{ post.SourceLabel() }</span><span>{ post.ReadingMins } min read</span></p>
						if related {
							<h3 class="post-card-title" id={ "card-" + post.Slug }>{ post.Title }</h3>
						} else {
							<h2 class="post-card-title" id={ "card-" + post.Slug }>{ post.Title }</h2>
						}
						<p class="post-card-summary">{ post.Summary }</p>
					</div>
					<div class="post-card-bottom">
						<span class="post-card-action">続きを読む <span aria-hidden="true">↗</span></span>
						<time datetime={ post.Published.Format("2006-01-02") }>{ post.DisplayDate() }</time>
					</div>
				</a>
			</article>
		}
	</div>
}

func postCoverKind(post content.Post) string {
	for _, tag := range post.Tags {
		switch tag {
		case "security", "web-security", "cve", "burp-suite":
			return "network"
		case "xnnpack", "simd", "cpu", "assembly", "compiler":
			return "chip"
		case "ai", "llm", "mamba", "pytorch", "機械学習", "画像認識":
			return "matrix"
		}
	}
	return "stack"
}

templ TopicPanel(title string, tags []content.Tag) {
	<aside class="topic-panel">
		<h2>{ title }</h2>
		<div class="tag-list">
			for _, tag := range tags {
				<a href={ templ.SafeURL("/tags/" + url.PathEscape(tag.Name)) }><span class="tag-name">{ tag.Name }</span><span class="tag-count">{ tag.Count }</span></a>
			}
		</div>
	</aside>
}

templ PostPage(site content.SiteConfig, post content.Post, related []content.Post) {
	@Layout(site, post.Title+" — "+site.Title) {
		<main id="main" class="article-shell shell">
			<a class="back-link" href="/">← 記事一覧</a>
			<article class="article">
				<header class="article-header">
					<p class="article-source"><span class="source-label" data-source={ post.Source }>{ post.SourceLabel() }</span></p>
					<p class="article-tags">
						for _, tag := range post.Tags {
							<span>{ tag } </span>
						}
					</p>
					<h1>{ post.Title }</h1>
					<p class="article-summary">{ post.Summary }</p>
					<div class="article-byline"><span>{ post.DisplayDate() } · { post.ReadingMins } min read</span><span>by { site.AuthorName }</span></div>
				</header>
				<div class="prose">@templ.Raw(string(post.HTML))</div>
			</article>
			if len(related) > 0 {
				<section class="related">
					<h2>あわせて読みたい</h2>
					@PostList(related, true)
				</section>
			}
		</main>
	}
}

templ TagPage(site content.SiteConfig, tag string, posts []content.Post, tags []content.Tag) {
	@Layout(site, tag+" — "+site.Title) {
		<main id="main" class="shell archive">
			<header class="archive-header"><a class="back-link" href="/">← 記事一覧</a><h1>{ tag }</h1><p class="archive-intro">{ len(posts) }本の記事</p></header>
			@PostList(posts, false)
			@TopicPanel("ほかのテーマ", tags)
		</main>
	}
}

templ AboutPage(site content.SiteConfig) {
	@Layout(site, "About — "+site.Title) {
		<main id="main" class="shell about">
			<h1>自己紹介と連絡先</h1>
			<div class="about-grid">
				<div><p class="about-lead">{ site.Bio }</p><p>diary は、GoやWeb開発を中心に、設計の判断や手を動かして得た学びを記録する個人ブログです。完成形だけでなく、迷った理由も残します。</p></div>
				<aside><h2>{ site.AuthorName }</h2><a class="text-link" href={ templ.SafeURL(site.GitHubURL) }>GitHubを見る →</a><p>Web開発やGoを中心とした開発案件のご依頼を受け付けています。<a href="mailto:james-yusuke@yecov.com">james-yusuke@yecov.com</a>までお気軽にご連絡ください。</p><p class="repo-note">記事は <a href={ templ.SafeURL(site.RepositoryURL) }>GitHubリポジトリ</a> のMarkdownで管理しています。</p></aside>
			</div>
		</main>
	}
}

templ NotFoundPage(site content.SiteConfig) {
	@Layout(site, "Not found — "+site.Title) {
			<main id="main" class="shell not-found"><p class="post-meta">404</p><h1>そのページは見つかりませんでした。</h1><p>URLを確認するか、記事一覧に戻ってください。</p><a class="text-link" href="/">記事一覧へ戻る →</a></main>
	}
}
