package views

import (
	"net/url"

	"github.com/james-yusuke/diary-blog/internal/content"
)

templ Layout(site content.SiteConfig, pageTitle string) {
	<!doctype html>
	<html lang="ja">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="description" content={ site.Description }/>
			<title>{ pageTitle }</title>
			<link rel="stylesheet" href="/assets/site.css"/>
			<script type="module" src="/assets/mermaid.js"></script>
		</head>
		<body>
			<a class="skip-link" href="#main">本文へ移動</a>
			<header class="site-header">
				<div class="shell nav-shell">
					<a class="brand" href="/">{ site.Title }</a>
					<nav aria-label="主要ナビゲーション">
						<a href="/">Articles</a>
						<a href="/about">About</a>
						<a href="/feed.xml">RSS</a>
					</nav>
				</div>
			</header>
			{ children... }
			<footer class="site-footer">
				<div class="shell footer-inner">
					<p><strong>{ site.AuthorName }</strong> が書く技術の記録。</p>
					<div><a href={ templ.SafeURL(site.GitHubURL) }>GitHub</a><span aria-hidden="true"> · </span><a href={ templ.SafeURL(site.RepositoryURL) }>Repository</a></div>
				</div>
			</footer>
		</body>
	</html>
}

templ HomePage(site content.SiteConfig, posts []content.Post, tags []content.Tag, query string) {
	@Layout(site, "diary — "+site.AuthorName) {
		<main id="main">
			<section class="hero shell">
				<p class="eyebrow">PERSONAL ENGINEERING JOURNAL</p>
				<h1>james yusuke<br/>個人ブログ</h1>
				<p class="hero-copy">{ site.Description }</p>
				<div class="author-line"><span class="monogram">JY</span><span>Written by { site.AuthorName }</span></div>
			</section>
			<section class="shell search-section" aria-label="記事検索">
				<form action="/" method="get" role="search">
					<label for="search">記事を検索</label>
					<div class="search-control"><input id="search" name="q" type="search" value={ query } placeholder="Go、設計、templ…"/><button type="submit">検索</button></div>
				</form>
			</section>
			<section class="shell content-grid">
				<div>
					if query == "" && len(posts) > 0 {
						<p class="eyebrow">FEATURED NOTE</p>
						<article class="featured-post">
							<p class="post-meta">{ posts[0].DisplayDate() } · { posts[0].ReadingMins } min read</p>
							<h2><a href={ templ.SafeURL(posts[0].URL()) }>{ posts[0].Title }</a></h2>
							<p>{ posts[0].Summary }</p>
							<a class="text-link" href={ templ.SafeURL(posts[0].URL()) }>続きを読む <span aria-hidden="true">→</span></a>
						</article>
					}
					<div class="section-heading">
						if query != "" {
							<p class="eyebrow">SEARCH RESULTS</p>
							<h2>「{ query }」に一致した記事</h2>
						} else {
							<p class="eyebrow">LATEST NOTES</p>
							<h2>最新の記事</h2>
						}
					</div>
					if len(posts) == 0 {
						<p class="empty-state">条件に一致する記事はありません。別のキーワードを試してください。</p>
					} else {
						<div class="post-list">
							for i, post := range posts {
								if query != "" || i > 0 {
									@PostCard(post)
								}
							}
						</div>
					}
				</div>
				<aside class="topic-panel" aria-label="タグ一覧">
					<p class="eyebrow">TOPICS</p>
					<h2>読むテーマ</h2>
					<div class="tag-list">
						for _, tag := range tags {
							<a href={ templ.SafeURL("/tags/" + url.PathEscape(tag.Name)) }>{ tag.Name } <span>{ tag.Count }</span></a>
						}
					</div>
				</aside>
			</section>
		</main>
	}
}

templ PostCard(post content.Post) {
	<article class="post-card">
		<p class="post-meta">{ post.DisplayDate() } · { post.ReadingMins } min read</p>
		<h3><a href={ templ.SafeURL(post.URL()) }>{ post.Title }</a></h3>
		<p>{ post.Summary }</p>
		<div class="post-card-bottom">
			<div class="inline-tags">
				for _, tag := range post.Tags {
					<span>{ tag }</span>
				}
			</div>
			<a aria-label={ post.Title+"を読む" } href={ templ.SafeURL(post.URL()) }>→</a>
		</div>
	</article>
}

templ PostPage(site content.SiteConfig, post content.Post, related []content.Post) {
	@Layout(site, post.Title+" — "+site.Title) {
		<main id="main" class="article-shell shell">
			<a class="back-link" href="/">← すべての記事</a>
			<article class="article">
				<header class="article-header">
					<p class="eyebrow">
						for _, tag := range post.Tags {
							<span>{ tag } </span>
						}
					</p>
					<h1>{ post.Title }</h1>
					<p class="article-summary">{ post.Summary }</p>
					<div class="article-byline"><span class="monogram">JY</span><span>{ post.DisplayDate() } · { post.ReadingMins } min read<br/>by { site.AuthorName }</span></div>
				</header>
				<div class="prose">@templ.Raw(string(post.HTML))</div>
			</article>
			if len(related) > 0 {
				<section class="related">
					<p class="eyebrow">RELATED NOTES</p>
					<h2>あわせて読みたい</h2>
					<div class="post-list">
						for _, candidate := range related {
							@PostCard(candidate)
						}
					</div>
				</section>
			}
		</main>
	}
}

templ TagPage(site content.SiteConfig, tag string, posts []content.Post, tags []content.Tag) {
	@Layout(site, tag+" — "+site.Title) {
		<main id="main" class="shell archive">
			<p class="eyebrow">TOPIC ARCHIVE</p>
			<h1>{ tag }</h1>
			<p class="archive-intro">{ len(posts) }本の記事</p>
			<div class="post-list">
				for _, post := range posts {
					@PostCard(post)
				}
			</div>
			<aside class="archive-tags">
				<p class="eyebrow">OTHER TOPICS</p>
				<div class="tag-list">
					for _, item := range tags {
						<a href={ templ.SafeURL("/tags/" + url.PathEscape(item.Name)) }>{ item.Name } <span>{ item.Count }</span></a>
					}
				</div>
			</aside>
		</main>
	}
}

templ AboutPage(site content.SiteConfig) {
	@Layout(site, "About — "+site.Title) {
		<main id="main" class="shell about">
			<p class="eyebrow">ABOUT DIARY</p>
			<h1>自己紹介&連絡先</h1>
			<div class="about-grid">
				<div><p class="about-lead">{ site.Bio }</p><p>diary は、GoやWeb開発を中心に、設計の判断や手を動かして得た学びを記録する個人ブログです。完成形だけでなく、迷った理由も残します。</p></div>
				<aside><p class="eyebrow">WRITTEN BY</p><h2>{ site.AuthorName }</h2><a class="text-link" href={ templ.SafeURL(site.GitHubURL) }>GitHubを見る →</a><p class="repo-note">記事は <a href={ templ.SafeURL(site.RepositoryURL) }>GitHubリポジトリ</a> のMarkdownで管理しています。</p></aside>
			</div>
		</main>
	}
}

templ NotFoundPage(site content.SiteConfig) {
	@Layout(site, "Not found — "+site.Title) {
		<main id="main" class="shell not-found"><p class="eyebrow">404</p><h1>そのページは<br/>見つかりませんでした。</h1><p>URLを確認するか、記事一覧に戻ってください。</p><a class="button-link" href="/">記事一覧へ戻る</a></main>
	}
}
